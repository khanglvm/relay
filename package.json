{
  "name": "@khanglvm/relay",
  "version": "0.27.0",
  "description": "Question boards with rich blocks (markdown, charts, mermaid, tables, code, diffs, video, sandboxed HTML), clickable local file-links, and element-level annotations for AI coding agents (Claude Code, Codex, …): ask users structured questions, present interactive visuals, collect inline comments, read answers as JSON — in a local browser board OR rendered INLINE inside the Claude & Codex apps as an MCP App (SEP-1865).",
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "mcp",
    "mcp-app",
    "mcp-ui",
    "model-context-protocol",
    "cli",
    "interactive-questions",
    "human-in-the-loop",
    "annotations",
    "charts",
    "prototype",
    "visualization",
    "agent-skill"
  ],
  "license": "MIT",
  "author": "Le Vu Minh Khang (https://github.com/khanglvm)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khanglvm/relay.git"
  },
  "homepage": "https://github.com/khanglvm/relay#readme",
  "bugs": "https://github.com/khanglvm/relay/issues",
  "type": "module",
  "bin": {
    "rly": "bin/rly.js",
    "relay": "bin/rly.js"
  },
  "files": [
    "bin",
    "src",
    "vendor",
    "skills",
    "docs",
    "!docs/assets",
    "schema",
    "types",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "lint": "biome ci --diagnostic-level=error .",
    "gen:schema": "node scripts/gen-schema.mjs --write",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "node test/e2e/smoke.test.mjs && node --test test/unit/*.test.mjs test/e2e/golden.test.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "prepack": "npm run build:types"
  },
  "devDependencies": {
    "@a2ui/web_core": "^0.15.0",
    "@biomejs/biome": "^2.6.8",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./spec": {
      "types": "./types/spec/index.d.ts",
      "default": "./src/spec/index.js"
    },
    "./a2ui": {
      "types": "./types/a2ui/compile.d.ts",
      "default": "./src/a2ui/compile.js"
    },
    "./a2ui-board": {
      "types": "./types/a2ui/board.d.ts",
      "default": "./src/a2ui/board.js"
    },
    "./mcp": {
      "types": "./types/mcp/index.d.ts",
      "default": "./src/mcp/index.js"
    },
    "./schema.json": "./schema/spec.v1.json",
    "./package.json": "./package.json"
  },
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  }
}
