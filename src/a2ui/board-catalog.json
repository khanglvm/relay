{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/khanglvm/relay/a2ui/catalog/board/v1",
  "catalogId": "https://github.com/khanglvm/relay/a2ui/catalog/board/v1",
  "protocolVersion": "1.0",
  "title": "Relay board catalog",
  "description": "A whole Relay board as one A2UI surface: the heading, content blocks, questions, a comment box and a submit button. Every component also carries `title` and `text` as plain text, so a renderer that does not know a component can draw those instead.",
  "instructions": "The surface is built by Relay from a board spec; an agent never writes it. The data model holds /answers/<questionId>, /notes/<questionId>, /comment, /annotations/<blockId> and /blockEdits/<blockId>. Draw the components you know, show `title` and `text` for the rest, bind each Question `value` and `note` to the data model, and send the data model back with the `relay.submit` action.",
  "components": {
    "Board": {
      "type": "object",
      "description": "The root (id `root`): the board heading, its intro, then the blocks, questions, comment box and submit button in order.",
      "properties": {
        "component": {
          "const": "Board"
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "text": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "intro": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "children": {
          "$ref": "common_types.json#/$defs/ChildList"
        },
        "responseRequired": {
          "type": "boolean"
        },
        "allowPartial": {
          "type": "boolean"
        }
      },
      "required": [
        "component",
        "title",
        "children"
      ]
    },
    "Question": {
      "type": "object",
      "description": "One question. `questionType` says how to draw it; `value` binds to the answer at /answers/<id> and `note` to /notes/<id>. Blocks that belong to the question are its children; a block with `optionValue` belongs to that option.",
      "properties": {
        "component": {
          "const": "Question"
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "text": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "ref": {
          "type": "string"
        },
        "height": {
          "type": "integer"
        },
        "optionValue": {
          "type": "string"
        },
        "questionId": {
          "type": "string"
        },
        "questionType": {
          "type": "string",
          "enum": [
            "single",
            "multi",
            "yesno",
            "text",
            "textarea",
            "scale",
            "color",
            "rank",
            "checklist",
            "allocate",
            "pick"
          ]
        },
        "label": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "description": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "statuses": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        },
        "itemNote": {
          "type": "boolean"
        },
        "overall": {
          "type": "boolean"
        },
        "other": {
          "type": "boolean"
        },
        "total": {
          "type": "integer"
        },
        "unit": {
          "type": "string"
        },
        "minLabel": {
          "type": "string"
        },
        "maxLabel": {
          "type": "string"
        },
        "presets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "placeholder": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "default": {
          "$ref": "common_types.json#/$defs/DynamicValue"
        },
        "hasNote": {
          "type": "boolean"
        },
        "value": {
          "$ref": "common_types.json#/$defs/DynamicValue"
        },
        "note": {
          "$ref": "common_types.json#/$defs/DynamicValue"
        },
        "children": {
          "$ref": "common_types.json#/$defs/ChildList"
        }
      },
      "required": [
        "component",
        "questionId",
        "questionType",
        "label",
        "value"
      ]
    },
    "Markdown": {
      "type": "object",
      "description": "Markdown text.",
      "properties": {
        "component": {
          "const": "Markdown"
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "text": {
          "$ref": "common_types.json#/$defs/DynamicString"
