        },
        "height": {
          "type": "integer"
        },
        "optionValue": {
          "type": "string"
        },
        "md": {
          "$ref": "common_types.json#/$defs/DynamicString"
        }
      },
      "required": [
        "component",
        "md"
      ]
    },
    "Chart": {
      "type": "object",
      "description": "A chart: a kind with labels and series, or a full Chart.js config.",
      "properties": {
