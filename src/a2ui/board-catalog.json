          "const": "Chart"
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "text": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "ref": {
          "type": "string"
        },
        "height": {
          "type": "integer"
        },
        "optionValue": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "labels": {
          "type": "array",
