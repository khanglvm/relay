        },
        "ref": {
          "type": "string"
        },
        "height": {
          "type": "integer"
        },
        "optionValue": {
          "type": "string"
        },
        "code": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "editable": {
          "type": "boolean"
        }
      },
      "required": [
