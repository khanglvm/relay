      "properties": {
        "component": {
          "const": "Table"
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "text": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "ref": {
          "type": "string"
        },
        "height": {
          "type": "integer"
        },
        "optionValue": {
          "type": "string"
        },
        "columns": {
          "type": "array"
        },
        "rows": {
          "$ref": "common_types.json#/$defs/DynamicValue"
        },
        "sortable": {
          "type": "boolean"
        },
        "filterable": {
          "type": "boolean"
        },
        "exportable": {
          "type": "boolean"
        }
      },
      "required": [
        "component",
        "columns",
        "rows"
      ]
    },
    "Code": {
      "type": "object",
      "description": "Source code.",
      "properties": {
        "component": {
          "const": "Code"
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "text": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "ref": {
          "type": "string"
        },
        "height": {
          "type": "integer"
        },
        "optionValue": {
          "type": "string"
        },
        "code": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "lang": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        }
      },
      "required": [
        "component",
        "code"
      ]
    },
    "Diff": {
      "type": "object",
      "description": "A unified diff.",
      "properties": {
        "component": {
          "const": "Diff"
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "text": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "ref": {
          "type": "string"
        },
        "height": {
          "type": "integer"
        },
        "optionValue": {
          "type": "string"
        },
        "diff": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "filename": {
          "type": "string"
        },
        "lang": {
          "type": "string"
        },
        "view": {
          "type": "string"
        },
        "review": {
          "type": "boolean"
        },
        "reviewKind": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        }
      },
      "required": [
        "component",
        "diff"
      ]
    },
    "Mermaid": {
      "type": "object",
      "description": "A Mermaid diagram.",
      "properties": {
        "component": {
          "const": "Mermaid"
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString"
