  "functions": {
    "openUrl": {
      "type": "object",
      "description": "Opens an https link in a new tab.",
      "returnType": "void",
      "allowedCallers": "rendererOnly",
      "requiresUserActivation": true,
      "properties": {
        "@call": {
          "const": "openUrl"
        },
        "args": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "@call",
        "args"
      ]
    }
  },
  "$defs": {
    "anyComponent": {
      "oneOf": [
        {
          "$ref": "#/components/Board"
        },
        {
          "$ref": "#/components/Question"
        },
        {
          "$ref": "#/components/Markdown"
        },
        {
          "$ref": "#/components/Chart"
        },
        {
          "$ref": "#/components/Table"
        },
