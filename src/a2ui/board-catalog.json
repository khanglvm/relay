        },
        "optionValue": {
          "type": "string"
        },
        "src": {
          "type": "string"
        },
        "alt": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "pins": {
          "type": "boolean"
        }
      },
      "required": [
        "component",
        "src"
      ]
    },
    "Compare": {
      "type": "object",
      "description": "Two pictures side by side with a slider.",
      "properties": {
        "component": {
          "const": "Compare"
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "text": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "ref": {
          "type": "string"
        },
        "height": {
          "type": "integer"
        },
        "optionValue": {
          "type": "string"
        },
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string"
        },
        "beforeLabel": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "afterLabel": {
          "$ref": "common_types.json#/$defs/DynamicString"
        }
      },
      "required": [
        "component",
        "before",
        "after"
      ]
    },
    "Html": {
      "type": "object",
      "description": "Custom markup. A host draws it in a sandboxed frame or shows the text fallback.",
      "properties": {
        "component": {
          "const": "Html"
        },
        "isolated": {
          "type": "boolean",
          "description": "Render the supplied document without host theme or annotation code."
