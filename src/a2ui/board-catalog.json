        },
        {
          "$ref": "#/components/Palette"
        },
        {
          "$ref": "#/components/Kpi"
        },
        {
          "$ref": "#/components/Typography"
        },
        {
          "$ref": "#/components/Video"
        },
        {
          "$ref": "#/components/Pdf"
        },
        {
          "$ref": "#/components/GitConflict"
        },
        {
          "$ref": "#/components/Widget"
        },
        {
          "$ref": "#/components/Comment"
        },
        {
          "$ref": "#/components/Submit"
        }
      ],
      "discriminator": {
        "propertyName": "component"
      }
    },
    "anyFunction": {
      "oneOf": [
        {
          "$ref": "#/functions/openUrl"
        }
      ]
    }
  }
